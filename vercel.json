{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/layanan",
      "destination": "/layanan.html"
    },
    {
      "source": "/portofolio",
      "destination": "/portofolio.html"
    },
    {
      "source": "/konsultasi",
      "destination": "/konsultasi.html"
    }
  ]
}
