# =========================================================================
# NexStack Studio - Environment Variables Example
# Salin file ini menjadi .env lalu isi nilai aslinya di server/hosting
# JANGAN PERNAH MENYIMPAN FILE .env DENGAN KUNCI ASLI KE DALAM GIT
# =========================================================================

# 1. Konfigurasi Server / Runtime
NODE_ENV=production
PORT=3000

# 2. Supabase / PostgreSQL Credentials
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
# SERVICE_ROLE_KEY HANYA untuk backend / serverless API, jangan masukkan di client JS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key

# 3. Email Service (Resend / SendGrid)
# Untuk pengiriman otomatis e-kuitansi lunas & proposal PDF
RESEND_API_KEY=re_123456789_abcdefg
EMAIL_FROM=billing@nexstack.id

# 4. Payment Gateway (Midtrans / Xendit / Tripay)
PAYMENT_GATEWAY_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-yourSecretKey
MIDTRANS_CLIENT_KEY=SB-Mid-client-yourClientKey
PAYMENT_WEBHOOK_SECRET=your_secure_webhook_secret_key

# 5. Keamanan & Rate Limiting
CORS_ORIGIN=*
